    "heic2any": "^0.0.4",
    "https-proxy-agent": "7.0.6",
    "ignore": "7.0.12",
    "katex": "0.19.0",
    "lucide-react": "0.577.0",
    "mermaid": "11.17.2",
    "motion": "12.43.0",
