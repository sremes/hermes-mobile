{
  "name": "hermes-mobile",
  "productName": "Hermes Mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Hermes Agent web client — the Hermes Desktop renderer running as a PWA (Electron stripped).",
  "author": "Nous Research (fork: Sami Remes)",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "clean": "npm run clean:renderer",
    "clean:renderer": "tsc --build tsconfig.json --clean",
    "dev": "npm run dev:renderer",
    "dev:renderer": "node scripts/assert-root-install.mjs && npm run clean:renderer && vite --host 0.0.0.0 --port 5174",
    "build": "node scripts/assert-root-install.mjs && node scripts/write-build-stamp.mjs && vite build",
    "i18n:keys": "node scripts/i18n-keys.mjs",
    "preview": "node scripts/assert-root-install.mjs && vite preview --host 0.0.0.0 --port 4174",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "fmt": "prettier --write 'src/**/*.{ts,tsx}' 'vite.config.ts'",
    "fix": "npm run lint:fix && npm run fmt",
    "test:ui": "vitest run --project ui",
    "test:unit": "vitest run --project unit",
    "test": "vitest run",
    "check:lint": "npm run typecheck && npm run lint",
    "perf": "node scripts/perf/run.mjs",
    "perf:serve": "node scripts/perf/serve.mjs"
  },
  "dependencies": {
    "@assistant-ui/core": "0.2.23",
    "@assistant-ui/react": "0.14.29",
    "@assistant-ui/react-streamdown": "0.3.7",
    "@audiowave/react": "0.6.2",
    "@chenglou/pretext": "0.0.9",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hermes/shared": "file:../shared",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@lezer/highlight": "1.2.5",
    "@nanostores/react": "1.1.0",
    "@nous-research/ui": "0.19.1",
    "@novnc/novnc": "1.7.0",
    "@simple-git/argv-parser": "2.0.1",
