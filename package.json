{
  "name": "hermes-mobile",
  "version": "0.1.0",
  "description": "Hermes Agent as an installable web app (PWA) \u2014 the Hermes Desktop renderer without Electron, mobile-first.",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "echo '\u2705 hermes-mobile workspace installed. Run: npm run build -w apps/desktop'",
    "install:root": "npm install --workspaces=false",
    "install:desktop": "npm install --workspace apps/desktop",
    "build": "npm run build -w apps/desktop",
    "dev": "npm run dev -w apps/desktop",
    "preview": "npm run preview -w apps/desktop",
    "typecheck": "npm run typecheck -w apps/desktop",
    "test:ui": "npm run test:ui -w apps/desktop"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.64.0",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "yauzl": "^3.3.1",
    "protobufjs": "^8.7.1",
    "brace-expansion": "5.0.9",
    "mermaid": "11.16.1",
    "dompurify": "3.4.13",
    "ip-address": "10.3.1",
    "nanoid@^3": "3.3.17",
    "nanoid@^6": "6.0.0",
    "js-yaml@^4": "4.3.1",
    "undici@^6": "6.28.0",
    "undici@^7": "7.29.0",
    "postcss": "8.5.23",
    "tar": "7.5.22"
  },
  "engines": {
    "node": ">=22.22.0",
    "npm": "<11.10.0 || >=11.17.0"
  },
  "allowScripts": {
    "unicode-animations": false,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
