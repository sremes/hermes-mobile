{
  "name": "hermes-mobile",
  "version": "0.1.0",
  "description": "Hermes Agent as an installable web app (PWA) — the Hermes Desktop renderer without Electron, mobile-first.",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "echo '✅ hermes-mobile workspace installed. Run: npm run build -w apps/desktop'",
    "install:root": "npm install --workspaces=false",
    "install:desktop": "npm install --workspace apps/desktop",
    "build": "npm run build -w apps/desktop",
    "dev": "npm run dev -w apps/desktop",
    "preview": "npm run preview -w apps/desktop",
    "typecheck": "npm run typecheck -w apps/desktop",
    "test:ui": "npm run test:ui -w apps/desktop"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.64.0",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0"
  },
  "overrides": {
    "@electron/osx-sign": {
      "isbinaryfile": "5.0.7"
    },
    "lodash": "4.18.1",
    "protobufjs": "^8.7.1",
    "brace-expansion": "5.0.12",
    "mermaid": "11.17.2",
    "dompurify": "3.4.17",
    "katex": "0.19.0",
    "ip-address": "10.7.4",
    "nanoid@^3": "3.3.20",
    "nanoid@^6": "6.0.2",
    "js-yaml@^4": "4.3.2",
    "undici@^6": "6.29.0",
    "undici@^7": "7.30.0",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "tar": "7.5.22",
    "source-map-js": "1.2.2",
    "yaml": "2.9.1",
    "vitest": "4.1.12",
    "@vitest/mocker": "4.1.12",
    "yauzl": "^3.3.1"
  },
  "engines": {
    "node": "^22.22.0 || ^24.11.0 || >=26.0.0",
    "npm": "<11.10.0 || >=11.17.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "get-windows@9.3.0": true,
    "unicode-animations": false
  }
}
